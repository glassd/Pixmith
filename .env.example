# Pixmith configuration — copy to `.env` and adjust as needed.
# Pixmith reads these from the process environment. A `.env` file is git-ignored.
# (Pixmith does not auto-load `.env`; set these in your shell or in your MCP
#  client's "env" block. This file just documents the options.)

# Path to the Codex binary. Pixmith auto-detects it per-OS and otherwise falls
# back to `codex` on PATH, so you usually do NOT need to set this. Override only
# if auto-detection misses. Examples by platform:
#   macOS:   CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex
#   Linux:   CODEX_BIN=/usr/local/bin/codex
#   Windows: CODEX_BIN=C:/Users/you/AppData/Local/Programs/codex/codex.exe
#   On PATH: CODEX_BIN=codex
# CODEX_BIN=

# Sandbox policy passed to `codex exec` when the OS sandbox is used.
# Default: workspace-write (read-only | workspace-write | danger-full-access).
# PIXMITH_SANDBOX=workspace-write

# Run Codex WITHOUT its OS sandbox. Codex sandboxing is macOS/Linux only
# (Seatbelt/Landlock); on Windows it blocks the file-save, so Pixmith bypasses
# it there by default. Default: true on Windows, false elsewhere.
# PIXMITH_BYPASS_SANDBOX=true

# Default directory for generated PNGs. Default: <project>/images
# PIXMITH_OUTPUT_DIR=/absolute/path/to/output

# Codex home directory (used to locate the backup generated_images/ copy).
# Default: ~/.codex
# CODEX_HOME=/absolute/path/to/.codex

# Hard timeout per generation, in milliseconds. Default: 300000 (5 minutes)
# PIXMITH_TIMEOUT_MS=300000

# How many generations may run at once. Each is a full Codex agent session
# against your ChatGPT quota, so keep this small. Extra requests queue and
# report status "queued". Default: 1
# PIXMITH_MAX_CONCURRENT=1

# The wait window: the longest any single tool call waits for a job, in
# milliseconds (2000-55000). Default: 45000 (45s) — long enough that a typical
# generation is returned by the first call. Keep it under your MCP client's
# per-request timeout; lower it if your client times out sooner than ~60s.
# PIXMITH_POLL_WAIT_MS=45000

# Where Pixmith keeps recent job durations (for time estimates).
# Default: <project>/.pixmith
# PIXMITH_STATE_DIR=/absolute/path/to/state

# Speed: stop Codex as soon as the finished PNG is on disk, without waiting for
# the agent's closing turn. Default: true
# PIXMITH_EARLY_EXIT=true

# Speed: hand the image prompt to the agent in a temp file so it does not retype
# it into its tool call. Generations only. Default: true (false on Windows)
# PIXMITH_FAST_PROMPT=true

# Model / reasoning effort for the agent that wraps the image call (not the
# image model). Default: whatever ~/.codex/config.toml says.
# PIXMITH_CODEX_MODEL=
# PIXMITH_CODEX_EFFORT=low

# Return the PNG inline as MCP image content. Default: true
# PIXMITH_RETURN_IMAGE=true

# Skip inlining for files larger than this many bytes. Default: 6291456 (6 MB)
# PIXMITH_MAX_INLINE_BYTES=6291456
